# Template only — copy to .env and fill that in. This file is committed, so it must never
# contain real credentials. `.env` is gitignored and is the file Django actually loads.

DJANGO_DEBUG=True

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Signs the auth JWTs. Separate from SECRET_KEY so the two can be rotated independently.
# Required — the app refuses to start without it. A guessable value lets anyone mint a
# token with role=admin.
JWT_SECRET=
JWT_EXPIRES_DAYS=7

ALLOWED_HOSTS=localhost,127.0.0.1

# Origins allowed to send credentialed requests (the Angular app). A credentialed request
# cannot use a wildcard, so the exact origin must be listed.
CORS_ORIGINS=http://localhost:4200

# --- MySQL ---
# `mysql` is the target. Set DB_ENGINE=sqlite to run without a MySQL server (the test
# suite does this).
DB_ENGINE=mysql
DB_NAME=ecommerce
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Razorpay. Without both, /api/payments/* returns 503 and only 'cod' orders work.
# The secret is NOT the same string as the key id — copy it from the dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Used by `python manage.py seed`. Must be a real email address — it is the admin login.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-at-least-8-chars
